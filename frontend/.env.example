# Copy to `.env` (or `.env.local`) and edit if your backend runs elsewhere.
#
# Use 127.0.0.1, not localhost. On Windows, `localhost` resolves to ::1 (IPv6)
# first, but uvicorn binds to 127.0.0.1 (IPv4) only, so the browser gets
# ERR_CONNECTION_REFUSED on the IPv6 attempt. Being explicit avoids that.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Base URL used to display uploaded images. Leave blank to use the Vite dev
# proxy (recommended in development).
VITE_MEDIA_BASE_URL=
