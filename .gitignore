# ------------------------------------------- User uploads and trained models
# Uploaded field photos are user data - never commit them.
uploads/**
!uploads/.gitkeep
!uploads/plants/.gitkeep
!uploads/soil/.gitkeep

# Trained model artifacts are large binaries. Regenerate them with the
# scripts in ml/ rather than committing them.
models/*.joblib
models/*.keras
models/*.h5
models/*.metrics.json
models/*_meta.json
!models/.gitkeep

# Generated training data
ml/irrigation/irrigation_dataset.csv

