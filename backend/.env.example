# ---------------------------------------------------------------------------
# Smart Sugarcane AI - backend environment
# Copy this file to `.env` and edit the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Change this to a long random string before deploying anywhere real.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_secure_secret

# SQLite by default so the project runs with zero setup on your own machine.
DATABASE_URL=sqlite:///./smart_sugarcane.db

# -- DEPLOYING (Vercel, Netlify, AWS Lambda) --------------------------------
# SQLite CANNOT be used on a serverless host. Each request may run in a fresh
# container with its own empty filesystem, so an account created by one request
# is invisible to the next and every login fails with "Incorrect email or
# password" even when the password is correct.
#
# Set DATABASE_URL in the hosting dashboard (NOT in this file) to a hosted
# Postgres connection string. The psycopg driver is already in requirements.txt,
# so the URL must use the postgresql+psycopg:// scheme:
#
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
#
# Supabase: Project Settings -> Database -> Connection string -> use the
# *Session pooler* host (not db.<ref>.supabase.co, which is IPv6-only), then
# swap the postgresql:// prefix for postgresql+psycopg://
#
# Until DATABASE_URL is set, the deployed API answers every /api/auth request
# with 503 and an explanation rather than pretending the password was wrong.

# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded plant / soil images are stored (relative to the project root).
UPLOAD_DIR=uploads

# Image model mode:
#   demo       -> transparent rule-based image heuristics, clearly labelled as DEMO
#   production -> load trained Keras models from the models/ directory
#   auto       -> use trained models if present, otherwise fall back to demo
MODEL_MODE=auto

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

# Optional: OpenWeatherMap API key for live weather.
# Get a free key at https://openweathermap.org/api - leave blank to disable live weather.
OPENWEATHER_API_KEY=
DEFAULT_WEATHER_CITY=Belagavi,IN

# Maximum accepted upload size in megabytes
MAX_UPLOAD_MB=10
